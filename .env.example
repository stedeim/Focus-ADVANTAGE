# GEMINI_API_KEY: Optional. Unused by the current MVP path.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted app URL. Used for notes / self-referential links.
# Production: https://focus-advantage.vercel.app
APP_URL="http://localhost:3000"

# Optional client-side override for magic-link redirects on web.
# Native iOS/Android builds ignore this and use focusadvantage://auth/callback.
# Defaults to window.location.origin when unset.
VITE_APP_URL="http://localhost:3000"

# Supabase (required for magic-link sign-in and cloud save).
# Project: the focus advantage (ref zsswidmafowdlwymuide)
VITE_SUPABASE_URL="https://zsswidmafowdlwymuide.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional Stripe payment link for the paywall CTA (USD, $9.99 / month).
# Defaults to the USD Premium link if unset.
# VITE_STRIPE_PAYMENT_LINK_URL="https://buy.stripe.com/3cI8wP3bbeJJ0eQ02424002"
